{
  "name": "desktop-cat",
  "productName": "Desktop Cat",
  "version": "2.0.0",
  "description": "A desktop cat that sits on your taskbar, wanders about and naps",
  "homepage": "https://github.com/NorthOuterTowner/desktop-pet",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NorthOuterTowner/desktop-pet.git"
  },
  "private": true,
  "license": "MIT",
  "author": {
    "name": "desktop-cat",
    "email": "NorthOuterTowner@users.noreply.github.com"
  },
  "scripts": {
    "start": "tauri dev",
    "stage": "node scripts/stage-web.mjs",
    "tauri": "tauri",
    "assets": "python tools/build_assets.py",
    "assets:probe": "python tools/build_assets.py --probe",
    "icons": "python tools/build_icons.py && tauri icon build/icon.png --output src-tauri/icons",
    "treat": "python tools/build_treat.py",
    "check:behavior": "node tools/_simulate.mjs",
    "dist": "node scripts/build-installers.mjs",
    "dist:win": "node scripts/build-installers.mjs --win",
    "dist:mac": "node scripts/build-installers.mjs --mac",
    "dist:all": "node scripts/build-installers.mjs --all",
    "pack": "node scripts/build-installers.mjs --dir"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.12.2"
  }
}
