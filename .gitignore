# dependencies
node_modules/

# packaging output. build/ is *not* ignored -- the app icons in there are generated
# but committed, so that packaging never needs the Python toolchain.
dist/
out/

# rust / tauri build output. Gigabytes of compiled crates, and `gen/` is generated
# from tauri.conf.json on every build.
target/
src-tauri/gen/
spike/**/src-tauri/gen/

# The page as Tauri embeds it: src/, assets/sprites/ and icons/ copied side by side
# by scripts/stage-web.mjs on every dev run and build.
.web/

# `tauri icon` always writes mobile icons as well. This app ships for Windows and
# macOS only.
src-tauri/icons/android/
src-tauri/icons/ios/

# python
__pycache__/
*.py[cod]
.venv/
venv/

# QA output from the asset pipeline
rsrc/_check/

# logs
*.log
npm-debug.log*

# editor / OS
.DS_Store
Thumbs.db
.idea/
*.swp
